# Copy to .env for local Docker Compose development; never use these placeholders in production.
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL=postgresql://saarthi:replace-with-a-long-local-password@db:5432/saarthi
SAARTHI_USER_AGENT=SaarthiMobilityDemo/0.1 (replace-with-your-contact)
SAARTHI_JWT_SECRET=replace-with-at-least-32-random-characters
# Optional provider overrides (defaults are public evaluation services).
SAARTHI_GEOCODING_URL=https://nominatim.openstreetmap.org/search
SAARTHI_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
