# Copy to .env for local Docker Compose development; never use these placeholders in production.
POSTGRES_PASSWORD=replace-with-a-long-local-owner-password
# Generate a separate standard-base64 value with: openssl rand -base64 32
RIDEFORGE_APP_PASSWORD=REPLACE_WITH_BASE64_RUNTIME_PASSWORD
# URL-encode the same RIDEFORGE_APP_PASSWORD in the URI password component.
DATABASE_URL=postgresql://rideforge_app:URL_ENCODED_RUNTIME_PASSWORD@db:5432/rideforge
RIDEFORGE_USER_AGENT=RideForgeMobilityDemo/0.1 (replace-with-your-contact)
RIDEFORGE_JWT_SECRET=replace-with-at-least-32-random-characters
# Great-circle driver pickup eligibility radius in kilometres (integer 1–100; default 20).
RIDEFORGE_DISPATCH_RADIUS_KM=20
# Maximum sequential driver offers before a ride is marked failed (integer 1–20; default 5).
RIDEFORGE_DISPATCH_MAX_ATTEMPTS=5
# Optional provider overrides (defaults are public evaluation services).
RIDEFORGE_GEOCODING_URL=https://nominatim.openstreetmap.org/search
RIDEFORGE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
RIDEFORGE_GEOCODING_CONTEXT=Noida, Uttar Pradesh, India
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For may be trusted.
# Empty (default) = use the socket peer address only. Read right-to-left.
RIDEFORGE_TRUSTED_PROXIES=
# Minimum spacing between geocoding calls in ms (0-60000). Defaults to 1000 for
# nominatim.openstreetmap.org (max 1 request/second) and 0 otherwise.
RIDEFORGE_GEOCODING_MIN_INTERVAL_MS=
# Public OSRM demo hosts also default to 1 request/second; other providers default to 0.
RIDEFORGE_ROUTING_MIN_INTERVAL_MS=
