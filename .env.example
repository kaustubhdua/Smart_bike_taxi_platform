# Copy to .env for local Docker Compose development; never use these placeholders in production.
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL=postgresql://rideforge:replace-with-a-long-local-password@db:5432/rideforge
RIDEFORGE_USER_AGENT=RideForgeMobilityDemo/0.1 (replace-with-your-contact)
RIDEFORGE_JWT_SECRET=replace-with-at-least-32-random-characters
# Great-circle driver pickup eligibility radius in kilometres (integer 1–100; default 20).
RIDEFORGE_DISPATCH_RADIUS_KM=20
# Maximum sequential driver offers before a ride is marked failed (integer 1–20; default 5).
RIDEFORGE_DISPATCH_MAX_ATTEMPTS=5
# Optional provider overrides (defaults are public evaluation services).
RIDEFORGE_GEOCODING_URL=https://nominatim.openstreetmap.org/search
RIDEFORGE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
