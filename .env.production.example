# Copy to .env and replace every placeholder before starting the production overlay.
# Generate both secrets independently with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
DATABASE_URL=postgresql://rideforge:REPLACE_WITH_THE_SAME_64_HEX_PASSWORD@db:5432/rideforge
RIDEFORGE_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_SECRET
RIDEFORGE_USER_AGENT=RideForge/1.0 (contact: replace-with-your-email@example.com)
RIDEFORGE_DOMAIN=rideforge.example.com
RIDEFORGE_DRIVER_DOMAIN=driver.rideforge.example.com
RIDEFORGE_PUBLIC_ORIGIN=https://rideforge.example.com
RIDEFORGE_ALLOWED_ORIGINS=https://rideforge.example.com,https://driver.rideforge.example.com
RIDEFORGE_DISPATCH_RADIUS_KM=20
# Public demo endpoints are for evaluation only; replace with contracted/self-hosted providers for commercial use.
RIDEFORGE_GEOCODING_URL=https://nominatim.openstreetmap.org/search
RIDEFORGE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
