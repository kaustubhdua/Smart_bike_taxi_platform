# Backend API origin (the UI appends /api/v1/routes/quote).
# Point this at the running local C++ API; the browser cannot start the API for you.
VITE_API_BASE_URL=http://localhost:8080

# Optional development routing adapters. Public demo endpoints are rate-limited.
VITE_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
VITE_ROUTING_BASE_URL=https://router.project-osrm.org/route/v1/driving

# Optional: Photon-compatible endpoint (https://github.com/komoot/photon, Apache-2.0) for
# search-as-you-type place suggestions. Leave empty to search only when the user submits,
# which is what the public Nominatim usage policy requires. Self-host or contract a provider.
VITE_AUTOCOMPLETE_URL=
